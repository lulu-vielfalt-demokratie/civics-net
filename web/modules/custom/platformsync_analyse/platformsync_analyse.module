<?php

use Drupal\node\Entity\Node;
use Drupal\taxonomy\Entity\Term;

/**
 * Implements hook_preprocess_node().
 */
function platformsync_analyse_preprocess_node(&$variables) {
  if ($variables['node']->bundle() === 'netzwerk_vergleich') {
    $raw = $variables['node']->get('field_vergleich_ergebnis')->value;
    $variables['vergleich_data'] = $raw ? json_decode($raw, TRUE) : [];
  }
}

/**
 * Implements hook_node_insert().
 * Nach jedem neuen Analyse-Node: ältere archivieren wenn > 20.
 */
function platformsync_analyse_node_insert($node) {
  if ($node->bundle() !== 'analyse_ergebnis') return;
  _platformsync_analyse_archiviere(20);
}

/**
 * Archiviert Analyse-Nodes wenn Gesamtanzahl > $max.
 */
function _platformsync_analyse_archiviere(int $max = 20) {
  // Alle Analyse-Nodes nach Erstellungsdatum sortiert
  $query = \Drupal::entityQuery('node')
    ->condition('type', 'analyse_ergebnis')
    ->condition('status', 1)
    ->sort('created', 'DESC')
    ->accessCheck(FALSE)
    ->execute();

  $nids = array_values($query);
  if (count($nids) <= $max) return;

  // Alles nach Position $max archivieren
  $zu_archivieren = array_slice($nids, $max);

  foreach ($zu_archivieren as $nid) {
    $node = Node::load($nid);
    if (!$node) continue;

    // Bereits archiviert?
    if (!$node->get('field_analyse_zeitraum')->isEmpty()) continue;

    // Term für Datum/Stunde suchen oder anlegen
    $created  = $node->getCreatedTime();
    $term_name = date('Y-m-d H', $created) . 'h';

    $terms = \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->loadByProperties([
        'vid'  => 'analyse_zeitraum',
        'name' => $term_name,
      ]);

    if (empty($terms)) {
      $term = Term::create([
        'vid'  => 'analyse_zeitraum',
        'name' => $term_name,
      ]);
      $term->save();
    } else {
      $term = reset($terms);
    }

    $node->set('field_analyse_zeitraum', ['target_id' => $term->id()]);
    $node->save();

    \Drupal::logger('platformsync_analyse')->info(
      'Node @nid archiviert in @term', ['@nid' => $nid, '@term' => $term_name]
    );
  }
}
