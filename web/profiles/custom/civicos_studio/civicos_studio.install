<?php

/**
 * @file
 * Install-Hooks für das Profil CivicOS Studio.
 *
 * Inhaltstypen, Felder und Rollen legt später das Modul civicos_rundgang
 * per Entity API an, nicht das Profil.
 */

/**
 * Implements hook_install().
 */
function civicos_studio_install() {
  // Benutzer 1 bekommt die Administratorrolle.
  $account = \Drupal\user\Entity\User::load(1);
  if ($account) {
    $account->addRole('administrator');
    $account->save();
  }
}
