<?php

/**
 * Implements hook_preprocess_paragraph__hero().
 */
function gga2_theme_preprocess_paragraph__hero(&$variables) {
  $query = \Drupal::entityQuery('node')
    ->condition('type', 'event')
    ->condition('status', 1)
    ->sort('field_event_date', 'ASC')
    ->range(0, 3)
    ->accessCheck(TRUE);

  $nodes = \Drupal\node\Entity\Node::loadMultiple($query->execute());

  $events = [];
  $schema_events = [];

  foreach ($nodes as $node) {
    $date_value = $node->field_event_date->value ?? NULL;
    $location = $node->field_location->value ?? NULL;

    if ($date_value) {
      $date = new \DateTime($date_value);
      $events[] = [
        'title' => $node->label(),
        'day' => $date->format('d'),
        'month' => $date->format('M'),
        'time' => $date->format('H:i') . ' Uhr',
        'location' => $location,
        'url' => $node->toUrl()->setAbsolute()->toString(),
      ];

      // Schema.org JSON-LD
      $schema_events[] = [
        '@type' => 'Event',
        'name' => $node->label(),
        'startDate' => $date->format('c'),
        'location' => [
          '@type' => 'Place',
          'name' => $location ?? 'Online',
        ],
        'url' => $node->toUrl()->setAbsolute()->toString(),
        'organizer' => [
          '@type' => 'Organization',
          'name' => 'Gerecht geht anders',
          'url' => 'https://gerechtgehtanders.com',
        ],
      ];
    } else {
      $events[] = [
        'title' => $node->label(),
        'day' => '—',
        'month' => '',
        'time' => NULL,
        'location' => $location,
        'url' => $node->toUrl()->setAbsolute()->toString(),
      ];
    }
  }

  $variables['naechste_termine_events'] = $events;

  // Cache-Tags setzen damit der Cache invalidiert wird wenn Events geändert werden
  $variables['#cache']['tags'][] = 'node_list';
  foreach ($nids as $nid) {
    $variables['#cache']['tags'][] = 'node:' . $nid;
  }
  $variables['#cache']['contexts'][] = 'url.path';

  // Countdown zur Landtagswahl Sachsen-Anhalt
  $wahl_datum = new \DateTime('2026-09-06');
  $heute = new \DateTime('today');
  $diff = $heute->diff($wahl_datum);
  $variables['countdown_tage'] = $diff->days;
  $variables['countdown_label'] = 'Tage bis zur Landtagswahl Sachsen-Anhalt';

  // Schema.org JSON-LD als attached asset
  if (!empty($schema_events)) {
    $schema = [
      '@context' => 'https://schema.org',
      '@graph' => $schema_events,
    ];
    $variables['#attached']['html_head'][] = [
      [
        '#type' => 'html_tag',
        '#tag' => 'script',
        '#attributes' => ['type' => 'application/ld+json'],
        '#value' => json_encode($schema, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT),
      ],
      'schema_org_events',
    ];
  }
}

/**
 * Implements hook_preprocess_page().
 */
function gga2_theme_preprocess_page(&$variables) {
  // Footer Brand Block
  $footer_blocks = \Drupal::entityTypeManager()
    ->getStorage('block_content')
    ->loadByProperties(['type' => 'footer_brand']);
  $footer_block = reset($footer_blocks);
  if ($footer_block) {
    $variables['footer_description'] = $footer_block->field_brand_description->value ?? '';
    $variables['footer_copyright'] = $footer_block->field_copyright->value ?? '';
    $variables['footer_instagram'] = $footer_block->field_instagram_url->uri ?? '';
    $variables['footer_bluesky'] = $footer_block->field_bluesky_url->uri ?? '';
    $variables['footer_email'] = $footer_block->field_contact_email->value ?? '';
  }
  $blocks = \Drupal::entityTypeManager()
    ->getStorage('block_content')
    ->loadByProperties(['type' => 'logo_grafik']);
  $block = reset($blocks);
  if ($block && !$block->field_logo_image->isEmpty()) {
    $file = $block->field_logo_image->entity;
    if ($file) {
      $variables['logo_image_url'] = \Drupal::service('file_url_generator')
        ->generateAbsoluteString($file->getFileUri());
    }
  }
}
