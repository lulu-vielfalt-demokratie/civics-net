<a href="#main-content" class="sr-only">Direkt zum Inhalt</a>

<header role="banner" class="site-header">
  <a href="{{ base_path }}" class="site-logo">
    {% if logo_image_url %}
      <div class="logo-grafik">
        <img src="{{ logo_image_url }}" alt="Logo Gerecht geht anders" />
      </div>
    {% endif %}
    <div class="logo-text-wrap">
      <span class="logo-text">gerecht geht <span class="logo-anders">anders</span></span>
      <span class="logo-sub">Demokratiedialoge</span>
    </div>
  </a>
  <div class="header-right">
    <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Navigation öffnen">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="main-nav" id="main-nav">
      {{ page.primary_menu }}
    </div>
    <a href="/#mitmachen" class="btn-nav">Mitmachen</a>
  </div>
</header>

<main id="main-content" role="main">
  {{ page.content }}
</main>

<footer role="contentinfo" class="site-footer">
  <div class="site-footer-inner">
    <div class="footer-grid">
      <div class="footer-brand-col">
        <div class="footer-brand">Gerecht geht <span>anders</span></div>
        {% if footer_description %}
          <p class="footer-desc">{{ footer_description }}</p>
        {% endif %}
      </div>
      {{ page.footer }}
    </div>
    <div class="footer-bottom">
      <span>{% if footer_copyright %}{{ footer_copyright }}{% else %}&copy; {{ "now"|date("Y") }} Gerecht geht anders{% endif %}</span>
      <div class="footer-social">
        {% if footer_instagram %}
          <a href="{{ footer_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer-social-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
            <span>Instagram</span>
          </a>
        {% endif %}
        {% if footer_bluesky %}
          <a href="{{ footer_bluesky }}" target="_blank" rel="noopener noreferrer" aria-label="Bluesky" class="footer-social-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.204-.659-.299-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/></svg>
            <span>Bluesky</span>
          </a>
        {% endif %}
      </div>
      <span>{% if footer_email %}<a href="mailto:{{ footer_email }}" style="color:inherit;text-decoration:none;">{{ footer_email }}</a>{% endif %}</span>
    </div>
    </div>
  </div>
</footer>
