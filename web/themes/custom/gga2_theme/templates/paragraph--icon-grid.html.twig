{% set is_dark = (paragraph.field_style.value == 'dark') %}
{% set section_id = is_dark ? 'wie' : 'warum' %}
{% set modifier = is_dark ? 'is-dark' : 'is-light' %}

<section id="{{ section_id }}" class="icon-grid-section {{ modifier }}">
  <div style="max-width:1100px;margin:0 auto;">

    <div class="icon-grid-head">
      <span class="section-label">{{ is_dark ? 'Wie' : 'Warum' }}</span>

      {% if content.field_title %}
        <h2>{{ content.field_title }}</h2>
      {% endif %}

      {% if content.field_intro %}
        <div class="icon-grid-intro">{{ content.field_intro }}</div>
      {% endif %}

      {% if paragraph.field_punchline.value %}
        <div class="icon-grid-punchline">{{ paragraph.field_punchline.value }}</div>
      {% endif %}
    </div>

    <div class="icon-grid">
      {% for item in paragraph.field_items %}
        {% set parts = item.value|split('|') %}
        <div class="icon-card">
          {% if parts[0] is not empty %}
            <div class="icon-card-badge">{{ parts[0] }}</div>
          {% endif %}
          {% if parts[1] is not empty %}
            <h3>{{ parts[1] }}</h3>
          {% endif %}
          {% if parts[2] is not empty %}
            <p>{{ parts[2] }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</section>
