<?php

/**
 * @file
 * Theme-Funktionen für openhuus.
 */

use Drupal\Core\Site\Settings;

/**
 * Implements hook_preprocess_html().
 *
 * Bindet Umami (selbst gehostet, cookielos) ein – nur wenn in der settings.php
 * der Site eine Website-ID gesetzt ist (Prod), nie auf Staging.
 */
function openhuus_preprocess_html(array &$variables): void {
  $id = Settings::get('openhuus_umami_website_id');
  if (!$id) {
    return;
  }
  $variables['#attached']['html_head'][] = [[
    '#tag' => 'script',
    '#attributes' => [
      'defer' => TRUE,
      'src' => Settings::get('openhuus_umami_script', 'https://analytics.civicos.de/script.js'),
      'data-website-id' => $id,
    ],
  ], 'openhuus_umami'];
}

/**
 * Implements hook_preprocess_page().
 *
 * Startseite: zeigt die neueste veröffentlichte „Startseite“ (unabhängig von
 * Node-IDs) und übergibt das Eröffnungsdatum an das JavaScript.
 */
function openhuus_preprocess_page(array &$variables): void {
  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }
  $variables['page']['#cache']['tags'][] = 'node_list:startseite';
  $variables['page']['#cache']['contexts'][] = 'user.permissions';
  $variables['page']['#attached']['drupalSettings']['openhuus']['opening'] =
    \Drupal::config('gaestehaus_booking.settings')->get('opening_date') ?: '2026-10-12';

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'startseite')
    ->condition('status', 1)
    ->sort('changed', 'DESC')
    ->range(0, 1)
    ->execute();
  if (!$ids) {
    return;
  }
  $node = $storage->load(reset($ids));
  $variables['startseite'] = \Drupal::entityTypeManager()->getViewBuilder('node')->view($node, 'full');
  if ($node->access('update')) {
    $variables['startseite_edit_url'] = $node->toUrl('edit-form')->toString();
  }
}
