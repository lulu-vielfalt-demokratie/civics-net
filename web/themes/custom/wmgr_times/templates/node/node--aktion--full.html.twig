{#
/**
 * @file
 * node--aktion--full.html.twig – Detailseite für Aktionen
 */
#}
<article{{ attributes.addClass('node--type-aktion') }} role="article">

  <div class="container">
    <div class="row">
      <div class="col-md-12">

        {# Header #}
        <header class="node__header" style="margin: 2rem 0 1.5rem; border-bottom: 2px solid #c9191e; padding-bottom: 1rem;">
          <h1 class="node__title">{{ label }}</h1>
          <div class="aktion-meta" style="color: #666; font-size: 0.9rem; margin-top: 0.5rem;">
            {% if aktion_datum_formatted %}
              <time datetime="{{ node.field_aktion_datum.value }}">
                {{ aktion_datum_formatted }}
              </time>
            {% endif %}
            {% if content.field_aktionstyp %}
              <span class="aktion-typ" style="background:#c9191e;color:#fff;padding:0.2rem 0.6rem;border-radius:100px;font-size:0.75rem;margin-left:0.5rem;">
                {{ content.field_aktionstyp }}
              </span>
            {% endif %}
          </div>
        </header>

        {# Titelbild #}
        {% if content.field_titelbild %}
          <div class="node__image" style="margin-bottom: 2rem;">
            {{ content.field_titelbild }}
          </div>
        {% endif %}

        {# Inhalt #}
        <div class="node__content" style="margin-bottom: 2rem;">
          {{ content.body }}
        </div>

        {# Externer Link #}
        {% if content.field_externer_link %}
          <div class="node__link" style="margin-bottom: 2rem;">
            {{ content.field_externer_link }}
          </div>
        {% endif %}

        {# Zurück-Link #}
        <div class="node__back" style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #ddd;">
          <a href="/aktionen" style="color: #c9191e; text-decoration: none;">
            ← {{ 'Alle Aktionen'|t }}
          </a>
        </div>

      </div>
    </div>
  </div>

</article>
