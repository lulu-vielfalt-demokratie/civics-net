<article{{ attributes.addClass('node--type-material') }} role="article">
  <div class="container">
    <div class="row">
      <div class="col-md-8 col-md-offset-2">
        <header style="margin:2rem 0 1.5rem;border-bottom:2px solid #c9191e;padding-bottom:1rem;">
          <h1>{{ label }}</h1>
          {% if content.field_materialtyp %}
            <span style="background:#c9191e;color:#fff;padding:0.2rem 0.6rem;border-radius:100px;font-size:0.75rem;">{{ content.field_materialtyp }}</span>
          {% endif %}
        </header>
        {% if content.field_titelbild %}<div style="margin-bottom:2rem;">{{ content.field_titelbild }}</div>{% endif %}
        <div class="node__content">{{ content.body }}</div>
        {% if content.field_datei %}
          <div style="margin-top:2rem;padding:1.5rem;background:#f5f5f5;border-radius:8px;">
            <h3 style="margin-bottom:1rem;">{{ 'Downloads'|t }}</h3>
            {{ content.field_datei }}
          </div>
        {% endif %}
        <div style="margin-top:2rem;padding-top:1rem;border-top:1px solid #ddd;">
          <a href="/material" style="color:#c9191e;text-decoration:none;">← {{ 'Alle Materialien'|t }}</a>
        </div>
      </div>
    </div>
  </div>
</article>
